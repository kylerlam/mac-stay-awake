<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Mac Stay Awake" Width="376" Height="423" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="12" Background="{DynamicResource Background}" Foreground="{DynamicResource Primary}" UseLayoutRounding="True">
<Window.Resources>
 <SolidColorBrush x:Key="Background" Color="White"/><SolidColorBrush x:Key="Primary" Color="#242424"/><SolidColorBrush x:Key="Secondary" Color="#858585"/><SolidColorBrush x:Key="Surface" Color="#FFFFFF"/><SolidColorBrush x:Key="Border" Color="#14000000"/><SolidColorBrush x:Key="Accent" Color="#007AFF"/><SolidColorBrush x:Key="ButtonText" Color="White"/><SolidColorBrush x:Key="Success" Color="#34C759"/>
 <Style TargetType="Button"><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource Primary}"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</Window.Resources>
<Grid><Canvas x:Name="Atmosphere" IsHitTestVisible="False" ClipToBounds="True"/><Grid Margin="20,23,20,18"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"><StackPanel>
 <Grid Height="56" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="18"><Border.Effect><DropShadowEffect Color="Black" Opacity="0.025" BlurRadius="16" ShadowDepth="6" Direction="270"/></Border.Effect><Rectangle x:Name="Logo" Width="40" Height="40" Fill="{DynamicResource Primary}"/></Border><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock x:Name="StatusTitle" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="StatusDetail" FontSize="12" Foreground="{DynamicResource Secondary}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></Grid>
 <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="20" Padding="14" Margin="0,0,0,16"><Border.Effect><DropShadowEffect Color="Black" Opacity="0.025" BlurRadius="16" ShadowDepth="6" Direction="270"/></Border.Effect><StackPanel>
 <Grid Height="24"><TextBlock x:Name="SleepLabel" VerticalAlignment="Center" Foreground="{DynamicResource Secondary}"/><Border x:Name="Pill" HorizontalAlignment="Right" CornerRadius="12" Padding="9,4"><TextBlock x:Name="StatusValue" FontSize="11" FontWeight="SemiBold"/></Border></Grid>
 <Border Height="1" Background="{DynamicResource Border}" Margin="0,11,0,11"/><Grid><TextBlock x:Name="CheckedLabel" Foreground="{DynamicResource Secondary}"/><TextBlock x:Name="CheckedValue" HorizontalAlignment="Right" FontWeight="Medium"/></Grid>
 </StackPanel></Border>
 <Button x:Name="Toggle" Height="38" Background="{DynamicResource Accent}" Foreground="{DynamicResource ButtonText}" BorderBrush="#29FFFFFF" Margin="0,0,0,9"/>
 <Button x:Name="Normal" Height="34" Margin="0,0,0,9" Visibility="Collapsed"/>
 <Button x:Name="Refresh" Height="34" Margin="0,0,0,13"/>
 <TextBlock x:Name="AutoLabel" TextAlignment="Center" TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource Secondary}"/>
 <TextBlock x:Name="Error" TextWrapping="Wrap" Foreground="#A84F0A" FontSize="11" Margin="0,12,0,0"/>
</StackPanel></ScrollViewer>
<StackPanel Grid.Row="1" Margin="0,14,0,0"><Border Height="1" Background="{DynamicResource Border}" Margin="0,0,0,10"/><Grid><StackPanel><TextBlock Text="Mac Stay Awake" FontSize="10" FontWeight="Medium"/><TextBlock x:Name="ThemeName" FontSize="10" Foreground="{DynamicResource Secondary}" Margin="0,3,0,0"/></StackPanel><Button x:Name="Menu" Width="38" Height="28" HorizontalAlignment="Right" Content="☰⌄" FontWeight="Normal"/></Grid></StackPanel>
</Grid></Grid></Window>